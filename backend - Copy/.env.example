# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=gym_attendance

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Owner account (used once by seed_owner.py to create the admin login)
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-this-password
OWNER_NOTIFY_EMAIL=owner@example.com

# Resend (email notifications) - get a key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=attendance@yourdomain.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
